# Required
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/what-to-cook
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Server
PORT=5000
NODE_ENV=development

# Production only: your frontend origin(s), comma-separated
# Example: https://what-to-cook.vercel.app
CLIENT_URL=http://localhost:5173

# Optional AI
OPENAI_API_KEY=
