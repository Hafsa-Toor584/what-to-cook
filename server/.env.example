# Required
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/what-to-cook
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Server
PORT=5000
NODE_ENV=development

# Production only: your frontend origin(s), comma-separated
# Example: https://what-to-cook.vercel.app
CLIENT_URL=http://localhost:5173

# Optional AI
OPENAI_API_KEY=

# Optional email (password reset). Without any of these, the reset link is only printed in server logs.
# Sender address used by every provider below, e.g. "What to Cook <you@gmail.com>"
MAIL_FROM=

# Preferred in production: HTTP email APIs work on hosts that block SMTP ports (Render free tier)
BREVO_API_KEY=
RESEND_API_KEY=

# SMTP works locally but is blocked on Render's free tier
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=16-char app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
